# Local environment for running the worker (do NOT commit secrets)
# Redis (either localhost or port-forward to cluster)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB connection string (e.g. mongodb://user:pass@host:port/db or Atlas URI)
MONGODB_URI=

# AWS credentials used for S3 uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_PROCESSED_BUCKET=
CLOUDFRONT_DOMAIN=

# FFmpeg / helpers (set if non-standard or to a videotoolbox-capable ffmpeg)
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_THREADS=2

# Worker tuning
WORKER_CONCURRENCY=1
S3_UPLOAD_CONCURRENCY=30
